							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"orcs\": \"{{orcs}}\",\n  \"parkName\": \"{{parkName}}\",\n  \"subAreaId\": \"{{subAreaId}}\",\n  \"subAreaName\": \"{{subAreaName}}\",\n  \"activity\": \"Frontcountry Camping\",\n  \"date\": \"202601\",\n  \"campingPartyNightsAttendanceStandard\": 100,\n  \"campingPartyNightsAttendanceSenior\": 20,\n  \"campingPartyNightsAttendanceSocial\": 5,\n  \"campingPartyNightsAttendanceLongStay\": 3,\n  \"winterCampingPartyNightsAttendanceStandard\": 0,\n  \"winterCampingPartyNightsAttendanceSocial\": 0,\n  \"campingPartyNightsRevenueGross\": 5000,\n  \"secondCarsAttendanceStandard\": 10,\n  \"secondCarsAttendanceSenior\": 2,\n  \"secondCarsAttendanceSocial\": 1,\n  \"secondCarsRevenueGross\": 200,\n  \"otherRevenueGrossSani\": 150,\n  \"otherRevenueElectrical\": 300,\n  \"otherRevenueShower\": 100,\n  \"otherRevenueGrossNonResident\": 750\n}",
